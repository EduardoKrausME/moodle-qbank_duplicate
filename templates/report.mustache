{{!
    Duplicate question report.
    @template qbank_duplicate/report

    Context: title, intro, categoryname, canscan, scanurl, sesskey,
    scanlabel, hasscan, noscans, summary, percent, hasmessage, message,
    toggleurl, togglelabel, haspairs, headers, pairs, pagingbar, nopairs.
}}
<div class="qbank-duplicate-report">
    <h2>{{title}}</h2>
    <p>{{intro}}</p>
    <p class="text-muted">{{{categoryname}}}</p>

    {{#canscan}}
        <form action="{{scanurl}}" method="post" class="mb-3">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="startscan" value="1">
            <button type="submit" class="btn btn-primary">{{scanlabel}}</button>
        </form>
    {{/canscan}}

    {{^hasscan}}
        <div class="alert alert-info" role="alert">{{noscans}}</div>
    {{/hasscan}}

    {{#hasscan}}
        <div class="mb-2">{{summary}}</div>
        <div class="progress mb-3" style="height: 1.25rem;">
            <div class="progress-bar" role="progressbar" style="width: {{percent}}%;"
                 aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100">{{percent}}%</div>
        </div>

        {{#hasmessage}}
            <div class="alert alert-warning" role="alert">{{message}}</div>
        {{/hasmessage}}

        <a href="{{{toggleurl}}}" class="btn btn-secondary btn-sm mb-3">{{togglelabel}}</a>

        {{#haspairs}}
            <table class="generaltable">
                <thead>
                    <tr>
                        <th scope="col">{{headers.questiona}}</th>
                        <th scope="col">{{headers.questionb}}</th>
                        <th scope="col">{{headers.similarity}}</th>
                        <th scope="col">{{headers.reason}}</th>
                        <th scope="col">{{headers.actions}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#pairs}}
                        <tr>
                            <td><a href="{{{urla}}}">{{{namea}}} [{{typea}}]</a></td>
                            <td><a href="{{{urlb}}}">{{{nameb}}} [{{typeb}}]</a></td>
                            <td>
                                {{#isaierror}}
                                    {{aierrorlabel}}
                                {{/isaierror}}
                                {{^isaierror}}
                                    {{classification}}
                                    <br>
                                    {{confidence}}
                                    <br>
                                    <small class="text-muted">{{heuristic}}</small>
                                {{/isaierror}}
                            </td>
                            <td>
                                {{reason}}
                                {{#hasevidence}}
                                    <ul class="mt-2 mb-0">
                                        {{#evidence}}
                                            <li>{{text}}</li>
                                        {{/evidence}}
                                    </ul>
                                {{/hasevidence}}
                            </td>
                            <td>
                                {{#canmanage}}
                                    <form action="{{actionurl}}" method="post">
                                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                                        <input type="hidden" name="pairid" value="{{pairid}}">
                                        <input type="hidden" name="returnurl" value="{{returnurl}}">
                                        <button class="btn btn-secondary btn-sm mb-1" type="submit"
                                                name="decision" value="notduplicate">{{notduplicatelabel}}</button>
                                        <button class="btn btn-secondary btn-sm mb-1" type="submit"
                                                name="decision" value="ignored">{{ignorelabel}}</button>
                                    </form>
                                {{/canmanage}}
                            </td>
                        </tr>
                    {{/pairs}}
                </tbody>
            </table>
            {{{pagingbar}}}
        {{/haspairs}}

        {{^haspairs}}
            <div class="alert alert-info" role="alert">{{nopairs}}</div>
        {{/haspairs}}
    {{/hasscan}}
</div>
